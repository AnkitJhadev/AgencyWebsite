# Email (required in production). Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@ignitly.com
CONTACT_FROM_EMAIL="Ignitly <noreply@ignitly.com>"

# Postgres connection string (Neon, Supabase, RDS, ...). Enquiries are stored here when set.
# Run `npm run db:migrate` once after setting it.
DATABASE_URL=

# Scheduling link (Calendly, Cal.com, ...). Shows "Book a call" buttons when set.
NEXT_PUBLIC_BOOKING_URL=
